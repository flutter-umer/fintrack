# FinTrack Backend — application.properties.example
#
# Copy this file to application.properties and fill in your local values.
# The application.properties file is git-ignored and must not be committed.
#
# Production deployments should use environment variables instead of
# committing credentials in any properties file.

# Application
spring.application.name=fintrack-backend
server.port=8080

# Auto-configuration exclusions
# Excludes the default in-memory UserDetailsService; Firebase is the identity provider.
spring.autoconfigure.exclude=org.springframework.boot.security.autoconfigure.UserDetailsServiceAutoConfiguration


# PostgreSQL DataSource
# Provide real values in application.properties or via environment variables:
#   SPRING_DATASOURCE_URL
#   SPRING_DATASOURCE_USERNAME
#   SPRING_DATASOURCE_PASSWORD
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/fintrack}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:your_db_username}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:your_db_password}

# JPA / Hibernate
# Use 'none' until Flyway/Liquibase manages the schema.
# Use 'update' for early local development convenience (no entities exist yet).
# The dialect is required by Hibernate 7 when starting without a live DB connection.
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=none
spring.jpa.open-in-view=false
spring.jpa.show-sql=false

# Firebase Admin SDK (Milestone 2 — implemented)
# Set GOOGLE_APPLICATION_CREDENTIALS as an environment variable pointing to a
# service-account JSON file downloaded from the Firebase Console.
# NEVER commit the service-account JSON file to source control.
# NEVER put the actual file path or any credential value in this file.
#
# Example (set in shell or .env before running the app):
#   export GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json
#
# If this variable is not set, the app starts but protected routes return 401.

# Logging
logging.level.root=WARN
logging.level.com.fintrack=INFO
logging.level.org.springframework.security=WARN
